DATABASE_URL=postgres://frp_user:frp_user123@localhost:5432/stock
API_TOKEN=changeme-generate-a-long-random-token

# Dev-only: set to "true" to make requireAuth let every request through
# without checking API_TOKEN. Only takes effect when NODE_ENV isn't
# "production" (see src/middleware/auth.js) - leave unset/false normally,
# only for local testing when a caller's own token isn't wired up yet.
SKIP_API_AUTH=false

# Stara aplikacja (OAuth2 password grant, framework pig4cloud) - używana
# przez POST /api/auth/login (logowanie w frp).
OLD_APP_BASE_URL=http://10.96.9.2
OLD_APP_CLIENT_ID=pig
OLD_APP_CLIENT_SECRET=pig
OLD_APP_TENANT_ID=1

# Wysyłanie operacji (przyjęcia/wydania) do CIP - patrz src/cip.js.
#   true            operacje idą do CIP (produkcja)
#   false / brak    nic nie idzie do CIP, API działa tak, jakby CIP je przyjął
#                   (rozwój i testy bez dostępu do CIP)
# Bezpieczny domyślny stan to wyłączone: włączasz je świadomie na produkcji.
CIP_SYNC=false

LOCK_TTL_SECONDS=45
PORT=4000
# Order photos - S3-compatible object storage (MinIO locally, see
# ../dockerPostgresql/docker-compose.yml; AGENTS.md's "Photos"). The
# access/secret pair must match that compose file's own
# MINIO_ROOT_USER/MINIO_ROOT_PASSWORD.
#
# S3_ENDPOINT has to be a host the phones and browsers can reach, not
# "localhost" or the docker service name: a photo is shown through a
# presigned URL that carries this host. On the warehouse LAN use the same
# machine address wpsApi itself is reached at.
S3_ENDPOINT=127.0.0.1
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=order-photos
